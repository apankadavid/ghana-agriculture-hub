// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FARMER
  BUYER
  SUPPLIER
  MACHINERY_OWNER
  SERVICE_PROVIDER
  TRANSPORTER
  AGRONOMIST
  WORKER
  BUSINESS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  phone        String?  @unique
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  profile  Profile?
  articles Article[]
  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  role        Role
  region      String
  city        String?
  bio         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  listings    Listing[]
  jobApplications JobApplication[]

  @@map("profiles")
}
enum ListingType {
  OFFER
  REQUEST
}

enum ListingCategory {
  PRODUCT
  INPUT
  MACHINERY
  SERVICE
  JOB
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  FULFILLED
}

model Listing {
  id          String          @id @default(cuid())
  profileId   String
  profile     Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type        ListingType
  category    ListingCategory
  status      ListingStatus   @default(ACTIVE)

  title       String
  description String?

  price       Decimal?        @db.Decimal(12, 2)
  priceUnit   String?

  quantity      Decimal?      @db.Decimal(12, 2)
  quantityUnit  String?

  availability  String?
  qualityGrade  String?
  paymentTerms  String?

  region      String
  city        String?

  images      ListingImage[]
  applications JobApplication[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("listings")
  @@index([category, status])
  @@index([region])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  url       String
  sortOrder Int      @default(0)

  @@map("listing_images")
}

model JobApplication {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  applicantId String
  applicant   Profile  @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  message     String?
  resumeUrl   String?

  createdAt   DateTime @default(now())

  @@unique([listingId, applicantId])
  @@map("job_applications")
}

enum ArticleCategory {
  CROPS
  PLANTING
  FERTILIZATION
  IRRIGATION
  PESTS_DISEASES
  MACHINERY
  HARVEST
}

model Article {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  category      ArticleCategory
  excerpt       String
  content       String
  coverImageUrl String?
  published     Boolean         @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}